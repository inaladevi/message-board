<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
   <link rel="preconnect" href="https://googleapis.com">
  <link rel="preconnect" href="https://gstatic.com" crossorigin>
  <link href="https://googleapis.com/css2?family=Quicksand:wght@500;700&display=swap" rel="stylesheet">
  <title>Drop a Note</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <main class="form-wrapper">
    <h1>Say something...</h1>

    <form method="POST" action="/new" class="composer-form">
      <div class="input-block">
        <label for="messageUser">Who are you?</label>
        <input type="text" id="messageUser" name="messageUser" required autocomplete="off" placeholder="Your nickname here...">
      </div>

      <div class="input-block">
        <label for="messageText">What's on your mind?</label>
        <input type="text" id="messageText" name="messageText" required autocomplete="off" placeholder="Spill it out...">
      </div>

      <div class="form-actions">
        <button type="submit" class="action-btn">Post it!</button>
        <a href="/" class="abort-link">Nevermind</a>
      </div>
    </form>
  </main>
</body>
</html>

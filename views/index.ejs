<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>The Breakroom</title>
  <link rel="preconnect" href="https://googleapis.com">
  <link rel="preconnect" href="https://gstatic.com" crossorigin>
  <link href="https://googleapis.com/css2?family=Quicksand:wght@500;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <header class="board-header search-header-wrap">
    <div class="header-main-row">
      <h1>What's the word?</h1>
      <a href="/new" class="action-btn">Drop a note</a>
    </div>
  
    <form method="GET" action="/search" class="search-form-inline">
      <input type="text" name="searchQuery" class="search-input-field" placeholder="Search by user or email..." required
        autocomplete="off">
      <button type="submit" class="action-btn search-submit-btn">Find 🔍</button>
    </form>
  </header>

  <main class="feed-container">
    <% messages.forEach((message)=> { %>
      <article class="feed-item">
        <div class="meta-row">
          <span class="author">
            @<%= message.user %>
              <% if (message.age) { %>
                <span class="user-age">• <%= message.age %> yrs</span>
                <% } %>
          </span>
          <span class="timestamp">at <%= message.added.toLocaleTimeString([], {hour: '2-digit' , minute:'2-digit'}) %></span>
        </div>

  
        <p class="user-email">
          <%= message.email %>
        </p>
        <p class="content">“<%= message.text %>”</p>
  
        <% if (message.bio) { %>
          <p class="user-bio">bio: <%= message.bio %>
          </p>
          <% } %>
  
            <div class="tag-wrapper">
              <a href="/message/<%= messages.indexOf(message) %>" class="detail-trigger">Read closer 👀</a>
            </div>
      </article>
      <% }); %>
  </main>
</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Lookup Results</title>
  <link rel="preconnect" href="https://googleapis.com">
  <link rel="preconnect" href="https://gstatic.com" crossorigin>
  <link href="https://googleapis.com/css2?family=Quicksand:wght@500;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/styles.css">
</head>
<body>

    <header class="board-header search-header-wrap">
    <div class="header-main-row">
      <h1>Results matching: "<%= queryText %>"</h1>
      <a href="/" class="abort-link">← Head back home</a>
    </div>
  </header>

  <main class="feed-container">
    <% if (searchResults.length === 0) { %>
      <article class="feed-item">
        <p class="search-empty-text">No profiles or notes found matching that tag.</p>
      </article>
    <% } else { %>
      <% searchResults.forEach((message) => { %>
        <article class="feed-item">
          <div class="meta-row">
            <span class="author">
              @<%= message.user %> 
              <% if (message.age) { %> 
                <span class="user-age">(<%= message.age %>)</span> 
              <% } %>
            </span>
            <span class="timestamp">at <%= message.added.toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'}) %></span>
          </div>
          
          <p class="user-email"><%= message.email %></p>
          <p class="content">“<%= message.text %>”</p>
          
          <% if (message.bio) { %>
            <p class="user-bio">bio: <%= message.bio %></p>
          <% } %>

          <div class="tag-wrapper">
            <a href="/message/<%= messages.indexOf(message) %>" class="detail-trigger">Read closer 👀</a>
          </div>
        </article>
      <% }); %>
    <% } %>
  </main>
</body>
</html>
